local USE_WHITELIST = true
local WHITELIST = {"Player1", "player2", "justin095025", "ratbu123503"}
local BLACKLIST = {"BadPlayer1", "BadPlayer2", "Exploiter123"}

local function isPlayerAllowed()
	if USE_WHITELIST then
		for _, name in ipairs(WHITELIST) do
			if player.Name == name then return true end
		end
		return false
	end
	for _, name in ipairs(BLACKLIST) do
		if player.Name == name then return false end
	end
	return true
end

