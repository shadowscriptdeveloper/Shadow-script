local function createScriptButtons(category)
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child.Name:match("ScriptButton") then child:Destroy() end
	end
	local totalHeight = 0
	for i, script in ipairs(scripts[category] or {}) do
		local button = Instance.new("TextButton")
		button.Name = "ScriptButton" .. i
		button.Size = UDim2.new(1, 0, 0, 35)
		button.Position = UDim2.new(0, 0, 0, totalHeight)
		button.BackgroundColor3 = Color3.fromRGB(40, 30, 80)
		button.BackgroundTransparency = 0.20
		button.BorderSizePixel = 0
		button.Text = script.name
		button.TextColor3 = Color3.fromRGB(200, 200, 255)
		button.TextSize = 12
		button.Font = Enum.Font.GothamBold
		button.ZIndex = 15
		button.Parent = scrollFrame
		Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)
		button.Activated:Connect(function()
			if script.url:match("^loadstring") then loadstring(script.url)() else print(script.url) end
		end)
		totalHeight += 40
	end
	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
end

